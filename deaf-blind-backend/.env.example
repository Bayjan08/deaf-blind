# Copy this to .env and fill in real values. NEVER commit .env.
ENV=dev
PORT=9000

# --- Database credentials ---
DB_USER=postgres
DB_PASS=your-db-password
DB_NAME=postgres

# --- Local dev: Cloud SQL public IP (GCP Console -> Cloud SQL -> Overview -> Public IP) ---
DB_HOST=your-cloud-sql-public-ip
DB_PORT=5432

# --- Cloud Run only (ignored locally; detected via K_SERVICE) ---
CLOUD_SQL_CONNECTION_NAME=deaf-blind-500005:europe-west1:deaf-blind-db-dev
