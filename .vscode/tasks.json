{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run Backend",
      "type": "shell",
      "command": "docker compose up --build backend",
      "presentation": {
        "reveal": "always",
        "panel": "new",
        "label": "Backend (Docker) :9000"
      },
      "isBackground": true,
      "problemMatcher": {
        "pattern": { "regexp": "^$" },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Building|Started",
          "endsPattern": "Application startup complete"
        }
      }
    },
    {
      "label": "Run Mobile",
      "type": "shell",
      "command": "flutter pub get && flutter run --dart-define=BACKEND_URL=http://10.0.2.2:9000",
      "options": {
        "cwd": "${workspaceFolder}/deaf-blind-mobile"
      },
      "presentation": {
        "reveal": "always",
        "panel": "new",
        "label": "Mobile (Flutter)"
      },
      "problemMatcher": []
    },
    {
      "label": "Run Both",
      "dependsOn": ["Run Backend", "Run Mobile"],
      "dependsOrder": "parallel",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    }
  ]
}
