# Copy this to .env and fill in real values. NEVER commit .env.
ENV=dev
PORT=9000

# --- Database credentials ---
DB_USER=postgres
DB_PASS=postgres
DB_NAME=deaf_blind

# --- Local dev: docker compose postgres (host tools use localhost; backend container overrides DB_HOST) ---
DB_HOST=localhost
DB_PORT=5432

# --- Cloud Run only (ignored locally; detected via K_SERVICE) ---
CLOUD_SQL_CONNECTION_NAME=deaf-blind-500005:europe-west1:deaf-blind-db-dev

# --- Integrations ---
GEMINI_API_KEY=

# --- Auth ---
JWT_SECRET=local-dev-jwt-secret-change-in-prod

# --- LiveKit (video meetings) ---
# Docker Compose: backend uses LIVEKIT_URL; clients use LIVEKIT_PUBLIC_URL
LIVEKIT_URL=ws://livekit:7880
LIVEKIT_PUBLIC_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
